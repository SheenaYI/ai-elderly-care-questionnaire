# ═══════════════════════════════════════════════════════════════════════════
# 环境变量模板 — 智能养老AI监测系统配置偏好与采纳意愿调查
# ═══════════════════════════════════════════════════════════════════════════
#
# 用法：复制为 .env（本地开发）或填到 Vercel / Netlify 的环境变量面板。
#       .env 本身**绝不允许**提交到 Git（请确认 .gitignore 里有 .env）。
#
# 本文件只含占位符，不含任何真实密钥。
#
# ┌───────────────────────────────────────────────────────────────────────┐
# │ 最重要的两条规则                                                        │
# │                                                                       │
# │ 1. VITE_ 前缀的变量会被 Vite **打包进前端代码**，任何访问网站的人都能看到。│
# │    → 所以 VITE_ 里只能放公开信息。                                       │
# │    → SUPABASE_SERVICE_ROLE_KEY 绝对不能写成 VITE_SUPABASE_SERVICE_ROLE_KEY，│
# │      也不能以任何方式出现在 src/、public/ 或浏览器能读到的代码/日志里。    │
# │                                                                       │
# │ 2. service_role key 一旦泄露 = 攻击者可绕过全部 RLS 读写/删除全部研究数据。│
# │    → 它只存在于服务端环境变量（Vercel/Netlify Secrets）与密码管理器中。     │
# │    → 万一怀疑泄露：立刻到 Supabase 控制台 Project Settings → API → Rotate。│
# └───────────────────────────────────────────────────────────────────────┘
# ═══════════════════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════════════════
# 一、前端（公开变量，会被打包进浏览器代码 —— 只放公开信息）
# ═══════════════════════════════════════════════════════════════════════════

# Supabase 项目 URL（公开）。控制台 → Project Settings → API → Project URL。
# 留空 → 前端进入 Demo 模式（数据不写入云端）。
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon 公钥（公开，安全性由 RLS 策略保证，而不是靠隐藏它）。
# ⚠️ 这里用的是 anon key；把它换成 service_role key 属于严重安全事故。
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 问卷提交接口路径。默认 /api/submit-survey，通常不需要修改。
# 仅当前后端不同域（例如前端部署在 Netlify、接口在 Vercel）时才需要填完整 URL。
VITE_SUBMIT_ENDPOINT=/api/submit-survey

# 问卷版本号，必须与代码常量（src/data/questionnaire.ts 的 QUESTIONNAIRE_VERSION）
# 以及数据库 questionnaire_versions 表中登记的版本一致。默认 V1.0。
# Pilot 与正式发放请使用不同版本号，分析时分开统计。
VITE_QUESTIONNAIRE_VERSION=V1.0

# 是否允许在"未配置后端"时以 Demo 模式完成提交（仅本地试填/演示用）。
# ⚠️ 生产环境（正式收集研究数据）必须设为 false，
#    否则参与者可能看到"完成"却没有任何数据入库。
VITE_ALLOW_DEMO_MODE=false


# ═══════════════════════════════════════════════════════════════════════════
# 二、服务端专用（私有变量 —— 绝不进入前端，绝不提交到 Git）
#     只被 api/submit-survey.ts 与 api/admin/export.ts 读取（process.env）。
#     在 Vercel：Project → Settings → Environment Variables（不要加 VITE_ 前缀）。
# ═══════════════════════════════════════════════════════════════════════════

# Supabase 项目 URL（服务端用）。可与 VITE_SUPABASE_URL 相同，但变量名不同、用途不同：
# 前者只给服务端代码读，后者会被打包进前端。
SUPABASE_URL=https://your-project-ref.supabase.co

# ⚠️⚠️ 最高机密：Supabase service_role key ⚠️⚠️
# 拥有它即可绕过全部 RLS，直接读写、导出甚至删除所有研究数据。
#   * 只允许出现在服务端环境变量里；
#   * 绝不允许写进任何 VITE_ 变量、前端代码、构建产物、截图、聊天记录或 Git 提交；
#   * 后端接口也不会把它返回给客户端，更不会写进日志。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-keep-it-server-side-only

# 可选：额外的管理员邮箱白名单（逗号分隔）。仅作为 research_admins 表的补充说明用途，
# 真正的权限判定始终以数据库中的 public.research_admins 白名单为准。
RESEARCH_ADMIN_ALLOWLIST=


# ═══════════════════════════════════════════════════════════════════════════
# 三、上线前自查清单
# ═══════════════════════════════════════════════════════════════════════════
#   [ ] 全仓库搜索 "service_role"：只应出现在 .env.example、文档与 api/ 的服务端代码里；
#       不应出现在任何 VITE_ 变量名、src/、public/ 或打包产物中。
#   [ ] VITE_ALLOW_DEMO_MODE=false（正式收集数据期间）。
#   [ ] .env 已在 .gitignore 中，且从未被提交过。
#   [ ] Supabase 后台已执行 supabase/schema.sql（或 migrations/0001–0003）。
#   [ ] research_admins 中已加入研究团队邮箱；Auth 已关闭公开注册。
#   [ ] 用 anon key 试查 participants 表，确认返回 permission denied（见 supabase/README.md）。
